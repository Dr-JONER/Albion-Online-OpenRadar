{{define "pages/ignorelist"}}
<div class="space-y-6 stagger" data-setting="settingIgnoreList">
    <div class="card bg-base-200">
        <div class="card-body">
            <h1 class="text-3xl font-bold text-base-content">忽略列表</h1>
            <p class="text-base-content/60 mt-2">名单中的名字不会触发警报声、屏幕闪烁或红色边框。被忽略的玩家仍会显示在玩家列表里。</p>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiIgnoreListAddNameOpen" aria-labelledby="label-settingUiIgnoreListAddNameOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="user-plus" class="w-5 h-5 text-primary"></i>
            <span id="label-settingUiIgnoreListAddNameOpen" data-setting-label="settingUiIgnoreListAddNameOpen">添加名字</span>
        </div>
        <div class="collapse-content">
            <div class="flex gap-3">
                <input type="text" data-ignore-input aria-labelledby="label-settingUiIgnoreListAddNameOpen" placeholder="玩家、公会或联盟名字"
                       class="input input-bordered flex-1">
                <button type="button" data-ignore-add class="btn btn-primary">添加名字</button>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiIgnoreListIgnoredNamesOpen" aria-labelledby="label-settingUiIgnoreListIgnoredNamesOpen"/>
        <div class="collapse-title text-xl font-semibold flex flex-wrap items-center gap-2">
            <i data-lucide="user-x" class="w-5 h-5 text-primary"></i>
            <span id="label-settingUiIgnoreListIgnoredNamesOpen" data-setting-label="settingUiIgnoreListIgnoredNamesOpen settingIgnoreList">已忽略名字</span>
            <span data-ignore-count class="badge badge-ghost font-mono"></span>
        </div>
        <div class="collapse-content">
            <div class="space-y-2">
                <p data-ignore-empty class="text-base-content/50 text-center py-8 italic">忽略列表是空的</p>
                <div data-ignore-items class="space-y-2"></div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/ignorelist"}}
<script>
    import('/scripts/utils/SettingControls.js').then(({registerBoundPage}) => registerBoundPage('ignorelist'));
</script>
{{end}}
