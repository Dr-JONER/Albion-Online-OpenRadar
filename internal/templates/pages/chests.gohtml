{{define "pages/chests"}}
<div class="space-y-6 stagger">
    <div class="card bg-base-200">
        <div class="card-body">
            <h1 class="text-3xl font-bold text-base-content">宝箱与地下城</h1>
            <p class="text-base-content/60 mt-2">配置宝箱、迷雾和地下城的检测。</p>
        </div>
    </div>

    <div role="alert" class="alert bg-warning/20 border border-warning/40">
        <i data-lucide="construction" class="w-5 h-5 text-warning"></i>
        <div>
            <h3 class="font-bold text-warning">实验性功能</h3>
            <p class="text-sm">宝箱检测仍在完善。有些内容可能显示不正确，或者完全不显示。</p>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiChestsRaritiesOpen" aria-labelledby="label-settingUiChestsRaritiesOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="archive" class="w-5 h-5 text-warning"></i>
            <span id="label-settingUiChestsRaritiesOpen" data-setting-label="settingUiChestsRaritiesOpen">宝箱</span>
        </div>
        <div class="collapse-content">
            <p class="text-base-content/60 text-sm mb-4">选择要在雷达上显示的宝箱稀有度。</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingChestsGreen" aria-labelledby="label-settingChestsGreen" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-2"></span>
                    <span id="label-settingChestsGreen" data-setting-label="settingChestsGreen" class="text-base-content/80 text-xs group-hover:text-base-content">绿色</span>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingChestsBlue" aria-labelledby="label-settingChestsBlue" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-3"></span>
                    <span id="label-settingChestsBlue" data-setting-label="settingChestsBlue" class="text-base-content/80 text-xs group-hover:text-base-content">蓝色</span>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingChestsPurple" aria-labelledby="label-settingChestsPurple" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-4"></span>
                    <span id="label-settingChestsPurple" data-setting-label="settingChestsPurple" class="text-base-content/80 text-xs group-hover:text-base-content">紫色</span>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingChestsYellow" aria-labelledby="label-settingChestsYellow" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-5"></span>
                    <span id="label-settingChestsYellow" data-setting-label="settingChestsYellow" class="text-base-content/80 text-xs group-hover:text-base-content">黄色</span>
                </label>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiChestsMistsOpen" aria-labelledby="label-settingUiChestsMistsOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="cloud-fog" class="w-5 h-5 text-secondary"></i>
            <span id="label-settingUiChestsMistsOpen" data-setting-label="settingUiChestsMistsOpen">迷雾</span>
        </div>
        <div class="collapse-content">
            <div class="space-y-4">
                <div class="grid grid-cols-[repeat(auto-fit,minmax(min(24rem,100%),1fr))] gap-4">
                    <div>
                        <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                            <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                            类型
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                <input type="checkbox" data-setting="settingMistsSolo" aria-labelledby="label-settingMistsSolo" class="checkbox checkbox-primary checkbox-xs">
                                <i data-lucide="user" class="w-4 h-4 text-base-content/50"></i>
                                <span id="label-settingMistsSolo" data-setting-label="settingMistsSolo" class="text-base-content/80 text-xs group-hover:text-base-content">单人</span>
                            </label>
                            <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                <input type="checkbox" data-setting="settingMistsDuo" aria-labelledby="label-settingMistsDuo" class="checkbox checkbox-primary checkbox-xs">
                                <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                                <span id="label-settingMistsDuo" data-setting-label="settingMistsDuo" class="text-base-content/80 text-xs group-hover:text-base-content">双人</span>
                            </label>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                            <i data-lucide="sparkles" class="w-4 h-4 text-base-content/50"></i>
                            附魔等级
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2">
                            <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                <input type="checkbox" data-setting="settingMistsEnchant0" class="checkbox checkbox-primary checkbox-xs">
                                <span id="label-settingMistsEnchant0" data-setting-label="settingMistsEnchant0" class="text-base-content/80 text-xs group-hover:text-base-content">E0</span>
                            </label>
                            <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                <input type="checkbox" data-setting="settingMistsEnchant1" class="checkbox checkbox-primary checkbox-xs">
                                <span id="label-settingMistsEnchant1" data-setting-label="settingMistsEnchant1" class="text-base-content/80 text-xs group-hover:text-base-content">E1</span>
                            </label>
                            <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                <input type="checkbox" data-setting="settingMistsEnchant2" class="checkbox checkbox-primary checkbox-xs">
                                <span id="label-settingMistsEnchant2" data-setting-label="settingMistsEnchant2" class="text-base-content/80 text-xs group-hover:text-base-content">E2</span>
                            </label>
                            <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                <input type="checkbox" data-setting="settingMistsEnchant3" class="checkbox checkbox-primary checkbox-xs">
                                <span id="label-settingMistsEnchant3" data-setting-label="settingMistsEnchant3" class="text-base-content/80 text-xs group-hover:text-base-content">E3</span>
                            </label>
                            <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                <input type="checkbox" data-setting="settingMistsEnchant4" class="checkbox checkbox-primary checkbox-xs">
                                <span id="label-settingMistsEnchant4" data-setting-label="settingMistsEnchant4" class="text-base-content/80 text-xs group-hover:text-base-content">E4</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2">
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingMistsWispCages" aria-labelledby="label-settingMistsWispCages" class="toggle toggle-primary toggle-sm">
                        <i data-lucide="box" class="w-4 h-4 text-base-content/50"></i>
                        <span id="label-settingMistsWispCages" data-setting-label="settingMistsWispCages" class="text-base-content/80 text-xs group-hover:text-base-content">显示 Wisp 囚笼</span>
                    </label>

                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingMistsWisps" aria-labelledby="label-settingMistsWisps" class="toggle toggle-primary toggle-sm">
                        <i data-lucide="sparkles" class="w-4 h-4 text-base-content/50"></i>
                        <span id="label-settingMistsWisps" data-setting-label="settingMistsWisps" class="text-base-content/80 text-xs group-hover:text-base-content">Wisp 标记（传送门出现前）</span>
                    </label>

                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingMistsKnightfallAbbey" aria-labelledby="label-settingMistsKnightfallAbbey" class="toggle toggle-primary toggle-sm">
                        <i data-lucide="church" class="w-4 h-4 text-base-content/50"></i>
                        <span id="label-settingMistsKnightfallAbbey" data-setting-label="settingMistsKnightfallAbbey" class="text-base-content/80 text-xs group-hover:text-base-content">显示 Knightfall Abbey</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiChestsDungeonsOpen" aria-labelledby="label-settingUiChestsDungeonsOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="door-open" class="w-5 h-5 text-primary"></i>
            <span id="label-settingUiChestsDungeonsOpen" data-setting-label="settingUiChestsDungeonsOpen">地下城</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(24rem,100%),1fr))] gap-4">
                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                        类型
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsSolo" aria-labelledby="label-settingDungeonsSolo" class="checkbox checkbox-primary checkbox-xs">
                            <i data-lucide="user" class="w-4 h-4 text-base-content/50"></i>
                            <span id="label-settingDungeonsSolo" data-setting-label="settingDungeonsSolo" class="text-base-content/80 text-xs group-hover:text-base-content">单人</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsGroup" aria-labelledby="label-settingDungeonsGroup" class="checkbox checkbox-primary checkbox-xs">
                            <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                            <span id="label-settingDungeonsGroup" data-setting-label="settingDungeonsGroup" class="text-base-content/80 text-xs group-hover:text-base-content">组队</span>
                        </label>
                    </div>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="sparkles" class="w-4 h-4 text-base-content/50"></i>
                        附魔等级
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant0" class="checkbox checkbox-primary checkbox-xs">
                            <span id="label-settingDungeonsEnchant0" data-setting-label="settingDungeonsEnchant0" class="text-base-content/80 text-xs group-hover:text-base-content">E0</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant1" class="checkbox checkbox-primary checkbox-xs">
                            <span id="label-settingDungeonsEnchant1" data-setting-label="settingDungeonsEnchant1" class="text-base-content/80 text-xs group-hover:text-base-content">E1</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant2" class="checkbox checkbox-primary checkbox-xs">
                            <span id="label-settingDungeonsEnchant2" data-setting-label="settingDungeonsEnchant2" class="text-base-content/80 text-xs group-hover:text-base-content">E2</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant3" class="checkbox checkbox-primary checkbox-xs">
                            <span id="label-settingDungeonsEnchant3" data-setting-label="settingDungeonsEnchant3" class="text-base-content/80 text-xs group-hover:text-base-content">E3</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant4" class="checkbox checkbox-primary checkbox-xs">
                            <span id="label-settingDungeonsEnchant4" data-setting-label="settingDungeonsEnchant4" class="text-base-content/80 text-xs group-hover:text-base-content">E4</span>
                        </label>
                    </div>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="flame" class="w-4 h-4 text-base-content/50"></i>
                        特殊
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsCorrupted" aria-labelledby="label-settingDungeonsCorrupted" class="checkbox checkbox-primary checkbox-xs">
                            <span class="w-3 h-3 rounded-full bg-error"></span>
                            <span id="label-settingDungeonsCorrupted" data-setting-label="settingDungeonsCorrupted" class="text-base-content/80 text-xs group-hover:text-base-content">腐化</span>
                            <div class="tooltip" data-setting-tip="settingDungeonsCorrupted" data-tip="腐化地下城入口（PvP）">
                                <span tabindex="0" role="img" aria-label="腐化地下城入口（PvP）" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsHellgate" aria-labelledby="label-settingDungeonsHellgate" class="checkbox checkbox-primary checkbox-xs">
                            <span class="w-3 h-3 rounded-full bg-tier-6"></span>
                            <span id="label-settingDungeonsHellgate" data-setting-label="settingDungeonsHellgate" class="text-base-content/80 text-xs group-hover:text-base-content">地狱之门</span>
                            <div class="tooltip" data-setting-tip="settingDungeonsHellgate" data-tip="地狱之门传送门（PvP）">
                                <span tabindex="0" role="img" aria-label="地狱之门传送门（PvP）" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/chests"}}
<script>
    import('/scripts/utils/SettingControls.js').then(({registerBoundPage}) => registerBoundPage('chests'));
</script>
{{end}}
