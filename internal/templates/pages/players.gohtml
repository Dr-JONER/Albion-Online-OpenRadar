{{define "pages/players"}}
<div class="space-y-6 stagger">
    <div class="card bg-base-200">
        <div class="card-body">
            <h1 class="text-3xl font-bold text-base-content">Players</h1>
            <p class="text-base-content/60 mt-2">Configure player detection and display settings.</p>
        </div>
    </div>

    <div role="alert" class="alert bg-info/20 border border-info/40">
        <i data-lucide="info" class="w-5 h-5 text-info"></i>
        <div>
            <h3 class="font-bold text-info">Why can't I see players on the radar?</h3>
            <p class="text-sm">The game only sends player names, not their positions. We can detect who enters your zone but cannot display them on the map.
                <a href="https://github.com/Nouuu/Albion-Online-OpenRadar/blob/main/docs/technical/PLAYER_POSITIONS_MITM.md"
                   target="_blank" rel="noopener noreferrer" class="link link-primary">Learn more</a>
            </p>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiPlayersDisplayOpen" aria-labelledby="label-settingUiPlayersDisplayOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="eye" class="w-5 h-5 text-primary"></i>
            <span id="label-settingUiPlayersDisplayOpen" data-setting-label="settingUiPlayersDisplayOpen">显示</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersDetect" aria-labelledby="label-settingPlayersDetect" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                    <span id="label-settingPlayersDetect" data-setting-label="settingPlayersDetect" class="text-base-content/80 text-xs group-hover:text-base-content">检测玩家</span>
                    <div class="tooltip" data-setting-tip="settingPlayersDetect" data-tip="追踪范围内的玩家。关闭后没有玩家列表、人数、闪屏、边框和声音。">
                        <span tabindex="0" role="img" aria-label="追踪范围内的玩家。关闭后没有玩家列表、人数、闪屏、边框和声音。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersShowEquipment" aria-labelledby="label-settingPlayersShowEquipment" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="backpack" class="w-4 h-4 text-base-content/50"></i>
                    <span id="label-settingPlayersShowEquipment" data-setting-label="settingPlayersShowEquipment" class="text-base-content/80 text-xs group-hover:text-base-content">显示装备</span>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersShowSpells" aria-labelledby="label-settingPlayersShowSpells" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="wand-2" class="w-4 h-4 text-base-content/50"></i>
                    <span id="label-settingPlayersShowSpells" data-setting-label="settingPlayersShowSpells" class="text-base-content/80 text-xs group-hover:text-base-content">显示技能</span>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersShowGuild" aria-labelledby="label-settingPlayersShowGuild" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="castle" class="w-4 h-4 text-base-content/50"></i>
                    <span id="label-settingPlayersShowGuild" data-setting-label="settingPlayersShowGuild" class="text-base-content/80 text-xs group-hover:text-base-content">显示公会名</span>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersShowTotalIp" aria-labelledby="label-settingPlayersShowTotalIp" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="gauge" class="w-4 h-4 text-base-content/50"></i>
                    <span id="label-settingPlayersShowTotalIp" data-setting-label="settingPlayersShowTotalIp" class="text-base-content/80 text-xs group-hover:text-base-content">显示总物品强度</span>
                    <div class="tooltip" data-setting-tip="settingPlayersShowTotalIp" data-tip="玩家当前穿戴装备的平均物品强度。">
                        <span tabindex="0" role="img" aria-label="玩家当前穿戴装备的平均物品强度。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersShowMounted" aria-labelledby="label-settingPlayersShowMounted" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="footprints" class="w-4 h-4 text-base-content/50"></i>
                    <span id="label-settingPlayersShowMounted" data-setting-label="settingPlayersShowMounted" class="text-base-content/80 text-xs group-hover:text-base-content">显示骑乘状态</span>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersShowHealthBars" aria-labelledby="label-settingPlayersShowHealthBars" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="heart-pulse" class="w-4 h-4 text-base-content/50"></i>
                    <span id="label-settingPlayersShowHealthBars" data-setting-label="settingPlayersShowHealthBars" class="text-base-content/80 text-xs group-hover:text-base-content">显示生命条</span>
                    <div class="tooltip" data-setting-tip="settingPlayersShowHealthBars" data-tip="有生命数据时，在玩家卡片上显示生命条。">
                        <span tabindex="0" role="img" aria-label="有生命数据时，在玩家卡片上显示生命条。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiPlayersAlertsOpen" aria-labelledby="label-settingUiPlayersAlertsOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="bell" class="w-5 h-5 text-warning"></i>
            <span id="label-settingUiPlayersAlertsOpen" data-setting-label="settingUiPlayersAlertsOpen">警报</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(24rem,100%),1fr))] gap-4">
                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="monitor" class="w-4 h-4"></i>
                        屏幕
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-error/10 border border-error/20 cursor-pointer group hover:bg-error/20 transition-colors">
                            <input type="checkbox" data-setting="settingAlertFlash" aria-labelledby="label-settingAlertFlash" class="toggle toggle-primary toggle-sm">
                            <i data-lucide="zap" class="w-4 h-4 text-base-content/50"></i>
                            <span id="label-settingAlertFlash" data-setting-label="settingAlertFlash" class="text-base-content/80 text-xs group-hover:text-base-content">屏幕闪烁</span>
                            <div class="tooltip" data-setting-tip="settingAlertFlash" data-tip="出现威胁时闪屏：黄区或红区的敌对玩家，以及黑区中的任何人。已忽略的名字除外。">
                                <span tabindex="0" role="img" aria-label="出现威胁时闪屏：黄区或红区的敌对玩家，以及黑区中的任何人。已忽略的名字除外。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-error/10 border border-error/20 cursor-pointer group hover:bg-error/20 transition-colors">
                            <input type="checkbox" data-setting="settingAlertBorder" aria-labelledby="label-settingAlertBorder" class="toggle toggle-primary toggle-sm">
                            <i data-lucide="square-dashed" class="w-4 h-4 text-base-content/50"></i>
                            <span id="label-settingAlertBorder" data-setting-label="settingAlertBorder" class="text-base-content/80 text-xs group-hover:text-base-content">附近有敌对时边框闪动</span>
                            <div class="tooltip" data-setting-tip="settingAlertBorder" data-tip="范围内有威胁时，雷达周围闪红色边框。已忽略的名字不计入。">
                                <span tabindex="0" role="img" aria-label="范围内有威胁时，雷达周围闪红色边框。已忽略的名字不计入。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="volume-2" class="w-4 h-4"></i>
                        声音
                    </h3>
                    <div class="grid grid-cols-1 gap-2 max-w-2xl">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-warning/10 border border-warning/20 cursor-pointer group hover:bg-warning/20 transition-colors">
                            <input type="checkbox" data-setting="settingAlertSound" aria-labelledby="label-settingAlertSound" class="toggle toggle-primary toggle-sm">
                            <i data-lucide="volume-2" class="w-4 h-4 text-base-content/50"></i>
                            <span id="label-settingAlertSound" data-setting-label="settingAlertSound" class="text-base-content/80 text-xs group-hover:text-base-content">声音警报</span>
                            <div class="tooltip" data-setting-tip="settingAlertSound" data-tip="在运行雷达的电脑上播放警报声，触发规则与“屏幕闪烁”相同。已忽略的名字不会触发。">
                                <span tabindex="0" role="img" aria-label="在运行雷达的电脑上播放警报声，触发规则与“屏幕闪烁”相同。已忽略的名字不会触发。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                        <div class="flex items-center gap-1.5 sm:gap-2 p-2 rounded-lg bg-base-300">
                            <i data-lucide="list" class="w-4 h-4 shrink-0 text-base-content/50"></i>
                            <label for="settingAlertSoundFile" data-setting-label="settingAlertSoundFile" class="text-base-content/80 text-xs whitespace-nowrap w-16 shrink-0">音效</label>
                            <select id="settingAlertSoundFile" data-setting="settingAlertSoundFile" class="select select-bordered select-sm ml-auto w-full max-w-56"></select>
                            <button id="previewSound" type="button" class="btn btn-ghost btn-xs btn-square"
                                    aria-label="播放所选警报声">
                                <i data-lucide="play" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <div class="flex items-center gap-1.5 sm:gap-2 p-2 rounded-lg bg-base-300">
                            <i data-lucide="sliders-horizontal" class="w-4 h-4 shrink-0 text-base-content/50"></i>
                            <span id="label-settingAlertSoundVolume" data-setting-label="settingAlertSoundVolume" class="text-base-content/80 text-xs whitespace-nowrap w-16 shrink-0">音量</span>
                            <span class="w-3 shrink-0" aria-hidden="true"></span>
                            <button type="button" data-nudge="settingAlertSoundVolume" data-dir="-1" aria-label="减小音量" title="减小音量" class="btn btn-ghost btn-xs btn-square ml-auto"><i data-lucide="minus" class="w-3 h-3"></i></button>
                            <input type="range" data-setting="settingAlertSoundVolume" aria-labelledby="label-settingAlertSoundVolume" min="0" max="1" step="0.05" class="range range-primary range-xs min-w-0 w-full max-w-64">
                            <button type="button" data-nudge="settingAlertSoundVolume" data-dir="1" aria-label="增大音量" title="增大音量" class="btn btn-ghost btn-xs btn-square"><i data-lucide="plus" class="w-3 h-3"></i></button>
                            <span data-value-for="settingAlertSoundVolume" class="text-xs text-base-content/60 font-mono tabular-nums w-14 shrink-0 text-right whitespace-nowrap"></span>
                            <button type="button" data-reset="settingAlertSoundVolume" aria-label="重置音量" title="重置音量" class="btn btn-ghost btn-xs btn-square"><i data-lucide="rotate-ccw" class="w-3 h-3"></i></button>
                        </div>
                        <div class="flex items-center gap-1.5 sm:gap-2 p-2 rounded-lg bg-base-300">
                            <i data-lucide="hourglass" class="w-4 h-4 shrink-0 text-base-content/50"></i>
                            <span id="label-settingAlertSoundCooldown" data-setting-label="settingAlertSoundCooldown" class="text-base-content/80 text-xs whitespace-nowrap w-16 shrink-0">冷却</span>
                            <div class="tooltip shrink-0" data-setting-tip="settingAlertSoundCooldown" data-tip="两次警报声之间的最短间隔。设为 0 则每次都播放。">
                                <span tabindex="0" role="img" aria-label="两次警报声之间的最短间隔。设为 0 则每次都播放。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                            <button type="button" data-nudge="settingAlertSoundCooldown" data-dir="-1" aria-label="减小冷却" title="减小冷却" class="btn btn-ghost btn-xs btn-square ml-auto"><i data-lucide="minus" class="w-3 h-3"></i></button>
                            <input type="range" data-setting="settingAlertSoundCooldown" aria-labelledby="label-settingAlertSoundCooldown" min="0" max="3000" step="100" class="range range-primary range-xs min-w-0 w-full max-w-64">
                            <button type="button" data-nudge="settingAlertSoundCooldown" data-dir="1" aria-label="增大冷却" title="增大冷却" class="btn btn-ghost btn-xs btn-square"><i data-lucide="plus" class="w-3 h-3"></i></button>
                            <span data-value-for="settingAlertSoundCooldown" class="text-xs text-base-content/60 font-mono tabular-nums w-14 shrink-0 text-right whitespace-nowrap"></span>
                            <button type="button" data-reset="settingAlertSoundCooldown" aria-label="重置冷却" title="重置冷却" class="btn btn-ghost btn-xs btn-square"><i data-lucide="rotate-ccw" class="w-3 h-3"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiPlayersTypesOpen" aria-labelledby="label-settingUiPlayersTypesOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="shield" class="w-5 h-5 text-primary"></i>
            <span id="label-settingUiPlayersTypesOpen" data-setting-label="settingUiPlayersTypesOpen">玩家类型</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersPassive" aria-labelledby="label-settingPlayersPassive" class="checkbox checkbox-success checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-success"></span>
                    <span id="label-settingPlayersPassive" data-setting-label="settingPlayersPassive" class="text-base-content/80 text-xs group-hover:text-base-content">和平</span>
                    <div class="tooltip" data-setting-tip="settingPlayersPassive" data-tip="显示未开启 PvP 标记的玩家。">
                        <span tabindex="0" role="img" aria-label="显示未开启 PvP 标记的玩家。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersFaction" aria-labelledby="label-settingPlayersFaction" class="checkbox checkbox-info checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-info"></span>
                    <span id="label-settingPlayersFaction" data-setting-label="settingPlayersFaction" class="text-base-content/80 text-xs group-hover:text-base-content">阵营</span>
                    <div class="tooltip" data-setting-tip="settingPlayersFaction" data-tip="显示开启阵营战标记的玩家。">
                        <span tabindex="0" role="img" aria-label="显示开启阵营战标记的玩家。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingPlayersHostile" aria-labelledby="label-settingPlayersHostile" class="checkbox checkbox-error checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-error"></span>
                    <span id="label-settingPlayersHostile" data-setting-label="settingPlayersHostile" class="text-base-content/80 text-xs group-hover:text-base-content">敌对</span>
                    <div class="tooltip" data-setting-tip="settingPlayersHostile" data-tip="显示敌对标记的玩家；黑区里的玩家都算敌对。不影响警报。">
                        <span tabindex="0" role="img" aria-label="显示敌对标记的玩家；黑区里的玩家都算敌对。不影响警报。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiPlayersLimitsOpen" aria-labelledby="label-settingUiPlayersLimitsOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="sliders-horizontal" class="w-5 h-5 text-primary"></i>
            <span id="label-settingUiPlayersLimitsOpen" data-setting-label="settingUiPlayersLimitsOpen">数量上限</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 gap-2 max-w-xl">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <i data-lucide="list" class="w-4 h-4 text-base-content/50"></i>
                    <span id="label-settingPlayersMaxDisplayed" data-setting-label="settingPlayersMaxDisplayed" class="text-base-content/80 text-xs whitespace-nowrap group-hover:text-base-content">最多显示玩家数</span>
                    <div class="tooltip" data-setting-tip="settingPlayersMaxDisplayed" data-tip="最多显示的玩家数量（1 到 100）。默认 50。">
                        <span tabindex="0" role="img" aria-label="最多显示的玩家数量（1 到 100）。默认 50。" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                    <input type="number" data-setting="settingPlayersMaxDisplayed" aria-labelledby="label-settingPlayersMaxDisplayed" min="1" max="100" step="1"
                           class="input input-bordered input-sm w-32 disabled:opacity-50 ml-auto">
                </label>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/players"}}
<script>
    Promise.all([import('/scripts/utils/SettingControls.js'), import('/scripts/utils/AlertSound.js')])
        .then(([{registerBoundPage}, {default: alertSound}]) => registerBoundPage('players', {
            init({root, signal}) {
                root.querySelector('#settingAlertSoundFile').value = alertSound.resolve().file;
                root.querySelector('#previewSound').addEventListener('click', () => alertSound.preview(), {signal});
            },
        }));
</script>
{{end}}
